generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Required by @shopify/shopify-app-session-storage-prisma
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model Project {
  id         String  @id @default(cuid())
  shop       String
  // Shopify customer GID (gid://shopify/Customer/...). Null when a sales rep creates
  // a project without linking it to a registered customer (showroom walk-in).
  customerId String?
  name       String
  archived   Boolean @default(false)
  shareToken String? @unique

  // Optional sales-rep metadata. Used only when a project is built on behalf of
  // a non-registered or anonymous client. Ignored for customer-owned projects.
  clientName  String?
  clientEmail String?
  clientPhone String?
  notes       String?

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  environments Environment[]
  files        ProjectFile[]

  @@index([shop])
  @@index([shop, customerId])
  @@index([shop, archived])
}

model ProjectFile {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Shopify File GID (gid://shopify/MediaImage/... or gid://shopify/GenericFile/...)
  shopifyFileId String
  fileName      String
  url           String
  mimeType      String?
  sizeBytes     Int?
  createdAt     DateTime @default(now())

  @@index([projectId])
}

model Environment {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  items     ProjectItem[]

  @@index([projectId, sortOrder])
}

model ProjectItem {
  id            String      @id @default(cuid())
  environmentId String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  // Shopify GIDs — full form (gid://shopify/Product/123, gid://shopify/ProductVariant/456)
  productId     String
  variantId     String
  // Cached product handle so we can fetch /products/<handle>.json directly
  // instead of scanning paginated /products.json. Optional — old items may
  // not have it; the live-fetch helper falls back to the scan in that case.
  productHandle String?
  quantity      Int         @default(1)
  // For products sold by coverage (calc.rendimiento_m2): the area the customer
  // actually asked for, before rounding up to whole units. Kept so the detail
  // view can show "10 m² → 4 cajas" and so the intent survives a change in the
  // product's rendimiento. Null for products not sold by area.
  targetM2      Float?
  // Waste margin applied on top of targetM2 when computing quantity (e.g. 10).
  wastePct      Int?
  note          String?
  addedAt       DateTime    @default(now())

  @@index([environmentId])
  @@index([variantId])
}
