# --- Shopify App credentials (from dev.shopify.com → your custom app) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Public app URL (Vercel deploy URL once we have it). Required for OAuth callback.
SHOPIFY_APP_URL=

# Comma-separated. Minimal scopes — App Proxy needs none, but we request
# read_products to keep options open for future Admin API use.
SCOPES=read_products

# Shop domain (single-tenant POC).
SHOP=pkyzzu-96.myshopify.com
SHOP_CURRENCY=ARS

# --- Database ---
DATABASE_URL=

# --- Local dev only (DO NOT set in production) ---
# When set to "1", skips the App Proxy HMAC check so you can hit
# /apps/projects directly in the browser without going through Shopify.
APP_PROXY_BYPASS=
DEV_CUSTOMER_ID=
