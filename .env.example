# --- Shopify App credentials (from dev.shopify.com → your custom app) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Public app URL (Vercel deploy URL once we have it). Required for OAuth callback.
SHOPIFY_APP_URL=

# Comma-separated OAuth scopes. Leave UNSET: when empty, app/shopify.server.ts
# uses DEFAULT_SCOPES, which mirrors access_scopes in shopify.app.toml
# (unauthenticated_read_product_listings,write_files). If you set it, it fully
# REPLACES the defaults, so it must list every scope the app needs.
# SCOPES=unauthenticated_read_product_listings,write_files

# Shop domain (single-tenant POC).
SHOP=pkyzzu-96.myshopify.com
SHOP_CURRENCY=ARS

# --- Database ---
DATABASE_URL=

# --- Local dev only (DO NOT set in production) ---
# When set to "1", skips the App Proxy HMAC check so you can hit
# /apps/projects directly in the browser without going through Shopify.
APP_PROXY_BYPASS=
DEV_CUSTOMER_ID=
