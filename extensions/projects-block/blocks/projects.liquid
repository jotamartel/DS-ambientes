<div
  class="dsa-projects"
  data-state="{% if customer == nil %}login{% else %}loading{% endif %}"
  data-customer-id="{{ customer.id }}"
  data-shop="{{ shop.permanent_domain }}"
  data-currency="{{ shop.currency }}"
  data-public-base="https://{{ shop.permanent_domain }}"
  data-empty-text="{{ block.settings.empty_text | escape }}"
  data-waste-pct="{{ block.settings.waste_pct | default: 10 }}"
  style="
    --dsa-bg: {{ block.settings.bg_color }};
    --dsa-text: {{ block.settings.text_color }};
    --dsa-btn-bg: {{ block.settings.btn_bg_color }};
    --dsa-btn-text: {{ block.settings.btn_text_color }};
    --dsa-stat-highlight: {{ block.settings.stat_highlight_color }};
  "
>
  <div class="dsa-container">
    <header class="dsa-header" data-dsa-header="list">
      <h1 class="dsa-title">{{ block.settings.heading }}</h1>

      {%- if customer == nil -%}
        <a href="/account/login" class="dsa-btn dsa-btn-primary">
          {{ block.settings.login_cta }}
        </a>
      {%- else -%}
        <button type="button" class="dsa-btn dsa-btn-primary" data-action="open-create">
          <span>{{ 'modal.new_project' | t }}</span>
          {% render 'icon-plus' %}
        </button>
      {%- endif -%}
    </header>

    {%- if customer == nil -%}
      <div class="dsa-wrapper">
        <p class="dsa-wrapper-text">{{ block.settings.login_prompt }}</p>
      </div>
    {%- else -%}
      <div class="dsa-app" data-state="loading">
        <div class="dsa-wrapper">
          <p class="dsa-wrapper-text">{{ block.settings.loading_text }}</p>
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- if customer != nil -%}

    {%- comment -%}
      Asks how much to add before creating the item. The m² fieldset is only
      revealed for products carrying the calc.rendimiento_m2 metafield.
    {%- endcomment -%}
    <template data-dsa-tpl="qty-modal">
      <dialog class="dsa-modal dsa-qty-modal" aria-labelledby="dsa-qty-modal-title">
        <button type="button" class="dsa-modal-close" data-action="modal-close" aria-label="{{ 'modal.close' | t }}">
          {% render 'icon-close' %}
        </button>
        <div class="dsa-modal-header">
          <h2 class="dsa-modal-title" id="dsa-qty-modal-title">{{ 'qty.title' | t }}</h2>
          <p class="dsa-modal-description" data-field="product"></p>
        </div>
        <form class="dsa-modal-body" onsubmit="return false">
          <div class="dsa-qty-area" data-field="area" hidden>
            <p class="dsa-qty-rendimiento" data-field="rendimiento"></p>
            <label class="dsa-field">
              <span class="dsa-field-label">{{ 'qty.m2_label' | t }}</span>
              <input
                type="number"
                name="m2"
                class="dsa-field-input"
                min="0.01"
                step="0.01"
                inputmode="decimal"
                placeholder="0"
                autocomplete="off"
              />
            </label>
            <label class="dsa-qty-waste">
              <input type="checkbox" name="waste" />
              <span data-field="waste-label"></span>
            </label>
          </div>

          <label class="dsa-field">
            <span class="dsa-field-label">{{ 'qty.units_label' | t }}</span>
            <input
              type="number"
              name="quantity"
              class="dsa-field-input"
              min="1"
              max="9999"
              step="1"
              inputmode="numeric"
              value="1"
              required
              autocomplete="off"
            />
          </label>

          <p class="dsa-qty-summary" data-field="summary" hidden></p>

          <button type="submit" class="dsa-btn dsa-btn-modal-save">{{ 'qty.submit' | t }}</button>
        </form>
      </dialog>
    </template>

    {%- comment -%} Reused modal markup: same dialog for "Nuevo proyecto" and "Nuevo ambiente" {%- endcomment -%}
    <template data-dsa-tpl="new-project-modal">
      <dialog class="dsa-modal" aria-labelledby="dsa-modal-title">
        <button type="button" class="dsa-modal-close" data-action="modal-close" aria-label="{{ 'modal.close' | t }}">
          {% render 'icon-close' %}
        </button>
        <div class="dsa-modal-header">
          <h2 class="dsa-modal-title" id="dsa-modal-title">{{ 'modal.new_project' | t }}</h2>
          <p class="dsa-modal-description">{{ block.settings.modal_description }}</p>
        </div>
        <form class="dsa-modal-body" data-action="modal-create" onsubmit="return false">
          <label class="dsa-field">
            <span class="dsa-field-label">{{ 'modal.name_label' | t }}</span>
            <input
              type="text"
              name="name"
              class="dsa-field-input"
              placeholder="{{ 'modal.name_placeholder' | t }}"
              required
              maxlength="120"
              autocomplete="off"
            />
          </label>
          <button type="submit" class="dsa-btn dsa-btn-modal-save">
            {{ 'modal.save' | t }}
          </button>
        </form>
      </dialog>
    </template>

    <template data-dsa-tpl="new-env-modal">
      <dialog class="dsa-modal" aria-labelledby="dsa-env-modal-title">
        <button type="button" class="dsa-modal-close" data-action="modal-close" aria-label="{{ 'modal.close' | t }}">
          {% render 'icon-close' %}
        </button>
        <div class="dsa-modal-header">
          <h2 class="dsa-modal-title" id="dsa-env-modal-title">{{ 'modal.new_env' | t }}</h2>
          <p class="dsa-modal-description">{{ block.settings.env_modal_description }}</p>
        </div>
        <form class="dsa-modal-body" data-action="env-modal-create" onsubmit="return false">
          <label class="dsa-field">
            <span class="dsa-field-label">{{ 'modal.env_name_label' | t }}</span>
            <input
              type="text"
              name="name"
              class="dsa-field-input"
              placeholder="{{ 'modal.env_name_placeholder' | t }}"
              required
              maxlength="80"
              autocomplete="off"
            />
          </label>
          <button type="submit" class="dsa-btn dsa-btn-modal-save">
            {{ 'modal.env_save' | t }}
          </button>
        </form>
      </dialog>
    </template>

    {%- comment -%} Project card (rendered per-item by JS, cloned from this template) {%- endcomment -%}
    <template data-dsa-tpl="project-card">
      <article class="dsa-project-card" data-action="open" data-id="">
        <div class="dsa-project-card-icon">
          {% render 'icon-calendar' %}
        </div>
        <h3 class="dsa-project-card-name" data-field="name"></h3>
        <div class="dsa-project-card-footer">
          <span class="dsa-project-card-count" data-field="count"></span>
          <span class="dsa-project-card-link">
            <span>{{ 'list.ver_detalle' | t }}</span>
            {% render 'icon-arrow-right' %}
          </span>
        </div>
      </article>
    </template>

    {%- comment -%} File card (rendered per project file in the detail view) {%- endcomment -%}
    <template data-dsa-tpl="file-card">
      <div class="dsa-file-card" data-file-id="">
        <a class="dsa-file-card-preview" target="_blank" rel="noopener" data-field="link">
          <img class="dsa-file-card-thumb" data-field="thumb" loading="lazy" alt="" hidden />
          <div class="dsa-file-card-icon" data-field="icon"></div>
        </a>
        <div class="dsa-file-card-info">
          <p class="dsa-file-card-name" data-field="name"></p>
          <p class="dsa-file-card-meta" data-field="meta"></p>
        </div>
        <button type="button" class="dsa-file-card-delete" data-action="file-delete" data-id="" aria-label="{{ 'files.delete' | t }}">
          {% render 'icon-trash' %}
        </button>
      </div>
    </template>

    {%- comment -%} Search result row (cloned per variant in the product-search panel) {%- endcomment -%}
    <template data-dsa-tpl="search-result-row">
      <article class="dsa-result-row" data-product-id="" data-variant-id="" data-product-handle="">
        <div class="dsa-result-img-wrap">
          <img class="dsa-result-img" data-field="img" loading="lazy" alt="" hidden />
          <div class="dsa-result-img-placeholder" data-field="img-placeholder"></div>
        </div>
        <div class="dsa-result-info">
          <p class="dsa-result-title" data-field="title"></p>
          <p class="dsa-result-price" data-field="price"></p>
        </div>
        <button type="button" class="dsa-btn dsa-btn-pill-sm" data-action="search-add">
          {{ 'search.add_product' | t }}
        </button>
      </article>
    </template>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "DS Ambientes — Proyectos",
  "target": "section",
  "stylesheet": "projects.css",
  "javascript": "projects.js",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fondo",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "default": "#1f1f1f"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Fondo del botón",
      "default": "#3e5852"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Texto del botón",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "stat_highlight_color",
      "label": "Color de la card de Productos (destacada)",
      "default": "#b7c0d8"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Mis proyectos"
    },
    {
      "type": "text",
      "id": "modal_description",
      "label": "Descripción del modal de nuevo proyecto",
      "default": "Asigná un nombre para identificar tu proyecto."
    },
    {
      "type": "text",
      "id": "env_modal_description",
      "label": "Descripción del modal de nuevo ambiente",
      "default": "Agregá un ambiente a tu proyecto para organizar los productos."
    },
    {
      "type": "text",
      "id": "login_prompt",
      "label": "Mensaje cuando no está logueado",
      "default": "Iniciá sesión en tu cuenta para ver y crear tus proyectos."
    },
    {
      "type": "text",
      "id": "login_cta",
      "label": "Texto del botón de login",
      "default": "Iniciar sesión"
    },
    {
      "type": "text",
      "id": "loading_text",
      "label": "Texto de carga",
      "default": "Cargando proyectos..."
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Texto cuando no hay proyectos",
      "default": "¡No tienes proyectos creados!"
    },
    {
      "type": "range",
      "id": "waste_pct",
      "label": "Margen de desperdicio (%)",
      "info": "Porcentaje que se ofrece sumar cuando el cliente carga los metros cuadrados a cubrir. Solo aplica a productos con el metacampo de rendimiento.",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "%",
      "default": 10
    }
  ]
}
{% endschema %}
