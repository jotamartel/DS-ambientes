{% comment %}
  DS Ambientes — Projects block.
  Renders the "Mis proyectos" experience inline in any page/section of the theme.
  All dynamic data is fetched client-side from /apps/projects/api/* (App Proxy).
{% endcomment %}

<div
  class="dsa-projects"
  data-customer-id="{{ customer.id }}"
  data-shop="{{ shop.permanent_domain }}"
  data-currency="{{ shop.currency }}"
  data-public-base="https://{{ shop.permanent_domain }}"
  style="--dsa-title-align: {{ block.settings.title_align }};"
>
  {%- if block.settings.heading != blank -%}
    <h2 class="dsa-heading">{{ block.settings.heading }}</h2>
  {%- endif -%}

  {%- if customer == nil -%}
    <div class="dsa-empty">
      <p class="dsa-empty-text">{{ block.settings.login_prompt }}</p>
      <a href="/account/login" class="dsa-btn dsa-btn-primary">{{ block.settings.login_cta }}</a>
    </div>
  {%- else -%}
    <div class="dsa-app" data-state="loading">
      <div class="dsa-loading">{{ block.settings.loading_text }}</div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "DS Ambientes — Proyectos",
  "target": "section",
  "stylesheet": "projects.css",
  "javascript": "projects.js",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Mis Proyectos"
    },
    {
      "type": "select",
      "id": "title_align",
      "label": "Alineación del título",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "login_prompt",
      "label": "Mensaje cuando no está logueado",
      "default": "Iniciá sesión en tu cuenta para ver y crear tus proyectos."
    },
    {
      "type": "text",
      "id": "login_cta",
      "label": "Texto del botón de login",
      "default": "Iniciar sesión"
    },
    {
      "type": "text",
      "id": "loading_text",
      "label": "Texto de carga",
      "default": "Cargando proyectos..."
    }
  ]
}
{% endschema %}
