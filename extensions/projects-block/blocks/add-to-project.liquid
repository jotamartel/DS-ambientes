{%- if request.page_type == 'product' -%}
  <div
    class="dsa-atp"
    data-customer-id="{{ customer.id }}"
    data-product-id="gid://shopify/Product/{{ product.id }}"
    data-product-handle="{{ product.handle }}"
    data-variant-id="gid://shopify/ProductVariant/{{ product.selected_or_first_available_variant.id }}"
    data-redirect-url="{{ block.settings.empty_redirect_url }}"
    data-i18n-added="{{ 'atp.added' | t }}"
    data-i18n-error-load="{{ 'atp.error_load' | t }}"
    data-i18n-error-load-project="{{ 'atp.error_load_project' | t }}"
    data-i18n-error-add="{{ 'atp.error_add' | t }}"
    data-i18n-empty-projects="{{ 'atp.empty_projects' | t }}"
    data-i18n-empty-envs="{{ 'atp.empty_envs' | t }}"
    style="
      --dsa-atp-bg: {{ block.settings.bg_color }};
      --dsa-atp-text: {{ block.settings.text_color }};
    "
  >
    {%- if customer == nil -%}
      <a href="/account/login" class="button-secondary">{{ 'atp.login_cta' | t }}</a>
    {%- else -%}
      <button type="button" class="button-secondary" data-action="open">
        {% render 'icon-plus-thin' %}
        {{ 'atp.add_to_project' | t }}
      </button>
    {%- endif -%}

    <template data-dsa-tpl="atp-modal">
      <dialog class="dsa-atp-drawer" aria-labelledby="dsa-atp-title">
        <button type="button" class="dsa-atp-close" data-action="close" aria-label="{{ 'atp.close' | t }}">
          {% render 'icon-close' %}
        </button>
        <div class="dsa-atp-header">
          <h2 id="dsa-atp-title" class="dsa-atp-title">{{ 'atp.title' | t }}</h2>
          <p class="dsa-atp-subtitle">{{ 'atp.subtitle' | t }}</p>
        </div>
        <div class="dsa-atp-body" data-field="body"></div>
        <div class="dsa-atp-footer">
          <button type="button" class="button" data-action="open-create">{{ 'atp.create_project' | t }}</button>
        </div>
      </dialog>
    </template>

    <template data-dsa-tpl="atp-project">
      <article class="dsa-atp-card">
        <button type="button" class="dsa-atp-card-head" data-action="pick-project">
          <span class="dsa-atp-card-icon">{% render 'icon-calendar-filled' %}</span>
          <span class="dsa-atp-card-titles">
            <span class="dsa-atp-card-name" data-field="name"></span>
            <span class="dsa-atp-card-meta" data-field="meta"></span>
          </span>
          <span class="dsa-atp-radio"></span>
        </button>
        <div class="dsa-atp-envs" data-field="envs" hidden></div>
        <button type="button" class="button-secondary" data-action="open-create-env" hidden>
          {{ 'modal.new_env' | t }}
        </button>
        <a class="dsa-atp-detail" data-field="detail" href="#" hidden>
          {{ 'atp.view_detail' | t }}
          {% render 'icon-arrow-right-filled' %}
        </a>
      </article>
    </template>

    <template data-dsa-tpl="atp-env">
      <div class="dsa-atp-env">
        <span class="dsa-atp-env-info">
          <span class="dsa-atp-env-head">
            <span class="dsa-atp-env-name" data-field="name"></span>
            <span class="dsa-atp-env-meta" data-field="meta"></span>
          </span>
          <span class="dsa-atp-env-price">
            <span class="dsa-atp-env-ars" data-field="ars"></span>
            <span class="dsa-atp-env-usd" data-field="usd"></span>
          </span>
        </span>
        <button type="button" class="dsa-atp-env-add" data-action="add-env" aria-label="{{ 'atp.add_to_project' | t }}">
          {% render 'icon-plus-thin' %}
        </button>
      </div>
    </template>

    <template data-dsa-tpl="atp-empty">
      <p class="dsa-atp-empty" data-field="msg"></p>
    </template>

    <template data-dsa-tpl="atp-loading">
      <p class="dsa-atp-loading">{{ 'atp.loading' | t }}</p>
    </template>

    <template data-dsa-tpl="atp-error">
      <p class="dsa-atp-error" data-field="msg"></p>
    </template>

    <template data-dsa-tpl="atp-new-project-modal">
      <dialog class="dsa-atp-modal" aria-labelledby="dsa-atp-project-modal-title">
        <button type="button" class="dsa-atp-close" data-action="modal-close" aria-label="{{ 'modal.close' | t }}">
          {% render 'icon-close' %}
        </button>
        <h2 class="dsa-atp-modal-title" id="dsa-atp-project-modal-title">{{ 'modal.new_project' | t }}</h2>
        <form class="dsa-atp-modal-body">
          <label class="dsa-atp-field">
            <span class="dsa-atp-field-label">{{ 'modal.name_label' | t }}</span>
            <input
              type="text"
              name="name"
              class="dsa-atp-field-input"
              placeholder="{{ 'modal.name_placeholder' | t }}"
              required
              maxlength="120"
              autocomplete="off"
            />
          </label>
          <button type="submit" class="dsa-atp-modal-save">{{ 'modal.save' | t }}</button>
        </form>
      </dialog>
    </template>

    <template data-dsa-tpl="atp-new-env-modal">
      <dialog class="dsa-atp-modal" aria-labelledby="dsa-atp-env-modal-title">
        <button type="button" class="dsa-atp-close" data-action="modal-close" aria-label="{{ 'modal.close' | t }}">
          {% render 'icon-close' %}
        </button>
        <h2 class="dsa-atp-modal-title" id="dsa-atp-env-modal-title">{{ 'modal.new_env' | t }}</h2>
        <form class="dsa-atp-modal-body">
          <label class="dsa-atp-field">
            <span class="dsa-atp-field-label">{{ 'modal.env_name_label' | t }}</span>
            <input
              type="text"
              name="name"
              class="dsa-atp-field-input"
              placeholder="{{ 'modal.env_name_placeholder' | t }}"
              required
              maxlength="80"
              autocomplete="off"
            />
          </label>
          <button type="submit" class="dsa-atp-modal-save">{{ 'modal.env_save' | t }}</button>
        </form>
      </dialog>
    </template>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Agregar a proyecto",
  "target": "section",
  "stylesheet": "add-to-project.css",
  "javascript": "add-to-project.js",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fondo del modal",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "default": "#1f1f1f"
    },
    {
      "type": "url",
      "id": "empty_redirect_url",
      "label": "Página de redirección cuando no hay proyectos / ambientes",
      "info": "Elegí la página a la que llevamos al cliente cuando no tiene proyectos o el proyecto elegido no tiene ambientes. Si se deja vacío, se usa /pages/mis-proyectos."
    }
  ]
}
{% endschema %}
